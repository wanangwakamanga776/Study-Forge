rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // GLOBAL DATA
    // -------------------------------------------------------------------------
    match /test/connection {
      allow read: if true;
    }

    match /global/aboutMe {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'wanangwakamanga776@gmail.com'; 
    }

    match /global/announcement {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'wanangwakamanga776@gmail.com';
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'wanangwakamanga776@gmail.com';
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow list, read: if isSignedIn() && (isOwner(incoming().userId) || request.auth.token.email == 'wanangwakamanga776@gmail.com');
      allow update, delete: if isSignedIn() && request.auth.token.email == 'wanangwakamanga776@gmail.com';
    }

    // AI Usage tracking - vital for cost control
    match /userUsage/{usageId} {
      allow read: if isSignedIn() && (usageId.startsWith(request.auth.uid));
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().count <= 101;
    }

    // -------------------------------------------------------------------------
    // USER STATS & PROFILES
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if true; // Public access for leaderboard
      allow write: if isOwner(userId);
      
      match /stats/main {
        allow read: if true; 
        allow write: if isOwner(userId);
      }

      // Private content sub-collections
      match /decks/{deckId} { allow read, write: if isOwner(userId); }
      match /quizzes/{quizId} { allow read, write: if isOwner(userId); }
      match /tasks/{taskId} { allow read, write: if isOwner(userId); }
      match /forgeCasts/{castId} { allow read, write: if isOwner(userId); }
      match /lessons/{lessonId} { allow read, write: if isOwner(userId); }
      match /sessions/{sessionId} { allow read, write: if isOwner(userId); }
    }

    // -------------------------------------------------------------------------
    // PUBLIC DECKS
    // -------------------------------------------------------------------------
    match /publicDecks/{deckId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().creatorId == request.auth.uid;
      allow update: if isSignedIn() && existing().creatorId == request.auth.uid;
      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;
    }
  }
}
