rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // GLOBAL DATA
    // -------------------------------------------------------------------------
    match /test/connection {
      allow read: if true;
    }

    match /global/aboutMe {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'wanangwakamanga776@gmail.com'; 
    }

    match /global/announcement {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'wanangwakamanga776@gmail.com'; 
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'wanangwakamanga776@gmail.com';
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && request.auth.token.email == 'wanangwakamanga776@gmail.com';
    }

    // -------------------------------------------------------------------------
    // USER STATS & PROFILES
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if true; // Allow reading profiles for leaderboard
      allow write: if isOwner(userId);
      
      match /stats/main {
        allow read: if true; // Allow reading stats for leaderboard
        allow write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // PRIVATE CONTENT (Decks, Quizzes, Tasks, ForgeCasts, Lessons)
    // -------------------------------------------------------------------------
    match /users/{userId}/{collectionName}/{docId} {
      allow read, write: if isOwner(userId) && collectionName in ['decks', 'quizzes', 'tasks', 'forgeCasts', 'lessons', 'sessions'];
    }

    // -------------------------------------------------------------------------
    // PUBLIC DECKS
    // -------------------------------------------------------------------------
    match /publicDecks/{deckId} {
      allow read: if true; // Public library is readable by all
      allow create: if isSignedIn() && incoming().creatorId == request.auth.uid;
      allow update: if isSignedIn() && existing().creatorId == request.auth.uid;
      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;
    }
  }
}
