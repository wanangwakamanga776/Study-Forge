rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // USER STATS
    // -------------------------------------------------------------------------
    match /users/{userId}/stats/main {
      function isValidUserStats(data) {
        return data.xp is number && data.level is number && data.streak is number && data.embers is number;
      }

      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserStats(incoming());
      allow update: if isOwner(userId) && isValidUserStats(incoming());
    }

    // -------------------------------------------------------------------------
    // PRIVATE CONTENT (Decks, Quizzes, Tasks, ForgeCasts)
    // -------------------------------------------------------------------------
    match /users/{userId}/{collectionName}/{docId} {
      allow read, write: if isOwner(userId) && collectionName in ['decks', 'quizzes', 'tasks', 'forgeCasts'];
    }

    // -------------------------------------------------------------------------
    // PUBLIC DECKS
    // -------------------------------------------------------------------------
    match /publicDecks/{deckId} {
      allow read: if true; // Public library is readable by all
      allow create: if isSignedIn() && incoming().creatorId == request.auth.uid;
      allow update: if isSignedIn() && existing().creatorId == request.auth.uid;
      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;
    }
  }
}
