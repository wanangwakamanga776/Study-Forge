# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NOTE: VITE_GEMINI_API_KEY is intentionally NOT set here.
# All AI calls go through the Supabase edge function; keys must never reach the client bundle.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret for express-session
SESSION_SECRET="YOUR_SESSION_SECRET"

# GOOGLE_CLIENT_ID: For Google OAuth
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

# GOOGLE_CLIENT_SECRET: For Google OAuth
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Supabase Configuration
# Users should provide these in the Secrets panel in AI Studio
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ---- Study Forge 2.0 AI gateway (server-side only; never in the client bundle) ----
PRIMARY_API_KEY="YOUR_PRIMARY_PROVIDER_API_KEY"
PRIMARY_BASE_URL="https://api.openai.com/v1"
PRIMARY_MODEL="gpt-4o-mini"
PRIMARY_NAME="primary"
FALLBACK_API_KEY="YOUR_FALLBACK_PROVIDER_API_KEY"
FALLBACK_BASE_URL="https://api.openai.com/v1"
FALLBACK_MODEL="gpt-4o-mini"
FALLBACK_NAME="fallback"
FREE_API_KEY="YOUR_FREE_TIER_API_KEY"
FREE_BASE_URL="https://api.openai.com/v1"
FREE_MODEL="gpt-4o-mini"
FREE_NAME="free"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIER="A"
PRICE_IN_PER_M="0"
PRICE_OUT_PER_M="0"
DAILY_SPEND_CAP_USD="5"

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN="YOUR_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_VERIFY_TOKEN="YOUR_WHATSAPP_VERIFY_TOKEN"

